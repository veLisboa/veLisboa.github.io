---
/**
 * /writing — the content hub.
 *
 * Not a blog. The newsletter is the blog; this page indexes it in English and links out to the
 * canonical editions: Portuguese on LinkedIn, English on Medium.
 *
 * Themes lead, editions follow. The six themes are the newsletter's own structure and are the
 * general answer to "what does he write about" — making the cadence and the range visible
 * matters more to a nominator than any single edition does.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Todo from "../../components/Todo.astro";
import { getCollection } from "astro:content";
import { byOrder } from "../../content.config";
import { writing as writingLinks, isTodo, writingThemes } from "../../config";

const editions = (await getCollection("writing")).sort(byOrder);
const linksUnknown = isTodo(writingLinks.linkedinNewsletter) || isTodo(writingLinks.medium);
---

<BaseLayout
  title="Writing"
  section="Writing"
  description="A newsletter on Microsoft Fabric, Power BI and governance — Portuguese on LinkedIn, English on Medium, indexed here across six themes.">
  <section class="container" style="margin-top:var(--space-9)">
    <div class="opener"></div>
    <h1 style="max-width:16em">Writing</h1>
    <p class="lead" style="margin-top:var(--space-6)">
      I write about Fabric, Power BI and governance most weeks. The editions run in Portuguese on
      LinkedIn; a growing set is published in English on Medium. This page indexes them in English.
    </p>
  </section>

  <!-- 01 · Themes -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader
        num="01"
        eyebrow="Themes"
        title="Six threads run through it"
        lede="The newsletter is written as a book rather than as a feed — each edition belongs to one of these, and they build on each other."
      />
      <div class="specs">
        {
          writingThemes.map((t) => (
            <div class="spec-row">
              <div class="spec-row__meta">
                <span class="num">{t.num}</span>
                {t.title}
              </div>
              <div class="spec-row__body">
                <p>{t.line}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 · The framework -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="02" eyebrow="The framework" />
    <div class="specs">
      <div class="spec-row">
        <div class="spec-row__meta">
          <span class="num">—</span>
          Canonical
        </div>
        <div class="spec-row__body">
          <h3 style="font-size:var(--step-2)">
            <a href="/writing/fabric-maturity-model/">The Fabric Maturity Model</a>
          </h3>
          <p style="color:var(--ink-secondary);margin-top:var(--space-4)">
            Five levels, the symptoms that identify each one, and the next move from where you are.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · Editions -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader
      num="03"
      eyebrow="Editions"
      title="Published in English"
      lede="These four have English versions. The Portuguese back catalogue is larger."
    />

    <div class="specs">
      {
        editions.map((e, i) => (
          <article class="spec-row">
            <div class="spec-row__meta">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              {e.data.titlePt && e.data.titlePt !== e.data.title ? "PT · EN" : "EN"}
            </div>
            <div class="spec-row__body">
              <h3 style="font-size:var(--step-1)">{e.data.title}</h3>
              {e.data.titlePt && e.data.titlePt !== e.data.title && (
                <p style="font-size:var(--step--1);color:var(--ink-tertiary);margin-top:var(--space-2)">
                  Published in Portuguese as “{e.data.titlePt}”
                </p>
              )}
              <p style="color:var(--ink-secondary);margin-top:var(--space-4)">{e.data.abstract}</p>
              {(e.data.linkedinUrl || e.data.mediumUrl) && (
                <p style="font-size:var(--step--1);margin-top:var(--space-4)">
                  {e.data.linkedinUrl && <a href={e.data.linkedinUrl}>Read in Portuguese</a>}
                  {e.data.linkedinUrl && e.data.mediumUrl && (
                    <span style="color:var(--ink-tertiary)"> · </span>
                  )}
                  {e.data.mediumUrl && <a href={e.data.mediumUrl}>Read in English</a>}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      linksUnknown && (
        <Todo
          what="These editions have no links yet — I do not have your LinkedIn newsletter or Medium URLs, and an index that links nowhere is worse than one that says so."
          source="Fill in writing.linkedinNewsletter and writing.medium in src/config.ts, then add linkedinUrl and mediumUrl per edition in src/content/writing/."
        />
      )
    }

    <Todo
      what="Four editions are indexed here — the four that already have English versions. The Portuguese back catalogue is larger and currently invisible to an English reader."
      source="Your own note says to pick the six strongest rather than doing all of them. One paragraph each, batchable."
    />
  </section>
</BaseLayout>
