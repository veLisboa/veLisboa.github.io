---
/**
 * /writing: writing and speaking, one page, one section each.
 *
 * Not a blog and not an index. The newsletter is the blog, and the two buttons are the only route
 * to it. An index of abstracts that links out is a second copy of the writing, kept in sync by
 * hand, and it was never worth the words.
 *
 * The language line appears here once and nowhere else on the site.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BrandButton from "../../components/BrandButton.astro";
import Icon from "../../components/Icon.astro";
import { writingThemes, social } from "../../config";
---

<BaseLayout
  title="Writing & speaking"
  section="Writing"
  description="A newsletter on Microsoft Fabric, Power BI and governance. Portuguese on LinkedIn, English on Medium, plus training, webinars and talks.">
  <section class="container" style="margin-top:var(--space-9)">
    <span class="kicker"></span>
    <h1 style="max-width:16em">
      Writing and <span class="tail">speaking.</span>
    </h1>
    <p class="lead" style="margin-top:var(--space-6)">
      I write about data platform architecture and governance most weeks. I write, teach and speak
      in English, Portuguese and Spanish.
    </p>
  </section>

  <!-- 01 · Subjects -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader num="01" eyebrow="Subjects" title="What I write and talk about" />
      <div class="specs">
        {
          writingThemes.map((t) => (
            <div class="spec-row">
              <div class="spec-row__meta spec-row__meta--icon">
                <span class="icon-tile">
                  <Icon name={t.icon} />
                </span>
                <span>
                  <span class="num">{t.num}</span>
                  {t.title}
                </span>
              </div>
              <div class="spec-row__body">
                <p>{t.line}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 · Where it is published -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="02" eyebrow="Where to read it" />
    <div class="brand-row">
      <BrandButton
        brand="linkedin"
        flag="br"
        href={social.newsletter}
        label="Newsletter on LinkedIn"
        language="Português"
      />
      <BrandButton
        brand="medium"
        flag="us"
        href={social.medium}
        label="Articles on Medium"
        language="English"
      />
    </div>
  </section>

  <!-- 03 · Speaking -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader num="03" eyebrow="Speaking" title="Training, webinars and talks" />
      <div class="prose">
        <p>
          My speaking base is training and webinars, with roughly 5,000 students across three
          languages. I am available for conference talks, workshops and corporate sessions.
        </p>
      </div>
      <a class="btn btn--secondary" style="margin-top:var(--space-7)" href="/speaking/one-pager/">
        <Icon name="mic" size={18} />
        Speaker one-pager
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (max-width: 480px) {
    .brand-row a {
      width: 100%;
    }
  }
</style>
