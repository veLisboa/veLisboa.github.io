---
/**
 * /writing/fabric-maturity-model — the site's anchor asset.
 *
 * This page is a deliberate, visible stub. The five levels have never been written down
 * anywhere — not in the Notion plan, not in the newsletter, not in any note I could find. The
 * plan's own first step for this page is "write the five level names and the one-line symptom
 * for each."
 *
 * So the page ships with its structure and its URL and no content. Inventing five levels and
 * publishing them under his name would poison the one page most likely to be cited by someone
 * who has never met him — which is the entire reason the page exists.
 *
 * The permanent URL is the point: a framework gets cited, and a citation needs somewhere stable
 * to point. That much can exist before the content does.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHeader from "../../components/ds/ArticleHeader.astro";
import Todo from "../../components/Todo.astro";
import Callout from "../../components/ds/Callout.astro";
---

<BaseLayout
  title="The Fabric Maturity Model"
  description="Five levels of Microsoft Fabric maturity, the symptoms that identify each one, and the next move from where you are.">
  <div class="container" style="margin-top:var(--space-9)">
    <ArticleHeader
      eyebrow="Framework"
      title="The Fabric Maturity Model"
      standfirst="Five levels, the symptoms that identify each one, and the single next move that advances it."
    />
  </div>

  <section class="container">
    <div class="prose">
      <Todo
        what="The five levels are not written down yet — not here, not in the newsletter, not in the plan. I have left this page empty rather than invent them. This is the page most likely to be cited by someone who has never met you, and a framework that does not hold up is worse than no framework."
        source="Your own first step: write the five level names and the one-line symptom for each. Everything else on this page follows from that."
      />
    </div>

    <div style="margin-top:var(--space-8);max-width:var(--measure)">
      <Callout label="What this page needs">
        A name for each of the five levels. For each: the symptoms that identify it from the
        inside, and the single next move that advances it. Then a diagram, and a short
        self-assessment a reader can run in about five minutes.
      </Callout>
    </div>

    <div class="prose" style="margin-top:var(--space-8)">
      <p style="color:var(--ink-secondary)">
        The URL is permanent and will not change, so it is safe to link to now.
      </p>
      <p><a href="/writing/">Back to writing</a></p>
    </div>
  </section>
</BaseLayout>
