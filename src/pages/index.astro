---
/**
 * Home — the whole site in one page.
 *
 * The test this page has to pass: someone should be able to learn everything they need here, and
 * open /work or /writing only if they want depth. So it carries the positioning, the proof, what
 * the work is, and how to make contact — and nothing that only exists to fill a band.
 *
 * Inversion appears exactly once, on the proof row, which is also where the accent goes.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import LogoWall from "../components/LogoWall.astro";
import StatStrip from "../components/StatStrip.astro";
import BrandButton from "../components/BrandButton.astro";
import CTA from "../components/CTA.astro";
import { platformLogos, affiliations, portrait, delivery, social } from "../config";

/**
 * Delivery figures are UPBI's; teaching figures are his own. The lede above the strip says which
 * is which — a number with no stated scope gets scoped by the reader, usually generously.
 */
const stats = [
  { value: delivery.projects, label: "Projects delivered in the last year" },
  { value: delivery.clients, label: "Client accounts" },
  { value: delivery.industries, label: "Industries served" },
  { value: "~5,000", label: "Students trained worldwide" },
  { value: "2022", label: "Microsoft Certified Trainer since" },
];

const whatIDo = [
  {
    num: "01",
    title: "Delivery",
    line: "I run Data and AI delivery and operations at UPBI: assessments, migrations and platform builds, and the teams and process behind them. I am also Data Tech Lead on a client engagement, leading a large SAP S/4HANA migration team for the Americas division of a Japanese industrial manufacturer.",
  },
  {
    num: "02",
    title: "Architecture and governance",
    line: "Reference architectures and governance models for Microsoft Fabric, Databricks and Azure — capacity and licensing, domain-driven workspaces, access and distribution. The test I apply is whether a team can still operate the controls after I leave.",
  },
  {
    num: "03",
    title: "Training",
    line: "Microsoft Certified Trainer since 2022, with roughly 5,000 students trained worldwide. I mentor Generative AI and Azure programs for Great Learning and for UT Austin's McCombs School of Business, including AI-900, PL-300 and Generative AI for Business.",
  },
  {
    num: "04",
    title: "Klarun",
    line: "I am the founder of Klarun, a B2B data catalog, metadata and lineage platform built on Microsoft Fabric, Power BI and Databricks. Every governance engagement I run hits the same wall, and Klarun is the attempt to remove it.",
  },
];
---

<BaseLayout section="Home">
  <!-- 01 · Hero -->
  <section class="container">
    <div class="hero">
      <div>
        <span class="eyebrow" style="display:block;margin-bottom:var(--space-5)">
          Vinicius Lisboa
        </span>
        <h1 class="hero__statement">
          I design and govern Fabric, Databricks and Azure estates, and train the teams that run
          them.
        </h1>
        <p class="hero__sub">
          I lead Data and AI delivery and operations at UPBI, a Microsoft-partner consultancy.
        </p>
      </div>
      <img
        class="hero__portrait"
        src={portrait}
        alt="Vinicius Lisboa"
        width="1242"
        height="1242"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- 02 · Proof. The one inverted band on the page. -->
  <section class="band band--invert">
    <div class="container">
      <SectionHeader
        num="01"
        eyebrow="Track record"
        lede="Delivery figures are UPBI's, the consultancy where I lead operations. Teaching figures are my own."
      />
      <StatStrip stats={stats} />
    </div>
  </section>

  <!-- 03 · What I do -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="02" eyebrow="What I do" />
    <div class="specs">
      {
        whatIDo.map((w) => (
          <div class="spec-row">
            <div class="spec-row__meta">
              <span class="num">{w.num}</span>
              {w.title}
            </div>
            <div class="spec-row__body">
              <p>{w.line}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="affil" style="margin-top:var(--space-8)">
      {affiliations.map((a) => <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />)}
    </div>
  </section>

  <!-- 04 · Work -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader
        num="03"
        eyebrow="Work"
        title="What the delivery looks like"
        lede="Professional background, the Microsoft and Databricks certifications, the delivery record broken out by industry, Klarun, seven reference architectures for Fabric and Databricks estates, and the agentic tooling I have been building around Power BI delivery. Client work is described by industry and never by name."
      />
      <p style="margin-top:var(--space-8)"><a href="/work/">Open Work</a></p>
    </div>
  </section>

  <!-- 05 · Writing and speaking -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader
      num="04"
      eyebrow="Writing and speaking"
      lede="I write about Fabric, Power BI and governance most weeks — in Portuguese on LinkedIn, in English on Medium. Four threads run through it: why Fabric, architecture and fundamentals, governance, and AI agents. The same four are what I speak and run workshops on."
    />
    <div class="brand-row">
      <BrandButton
        brand="linkedin"
        flag="br"
        href={social.newsletter}
        label="Newsletter on LinkedIn"
        language="Português"
      />
      <BrandButton
        brand="medium"
        flag="us"
        href={social.medium}
        label="Articles on Medium"
        language="English"
      />
    </div>
    <p style="margin-top:var(--space-8)"><a href="/writing/">Writing and speaking</a></p>
  </section>

  <!-- 06 · Platforms -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader num="05" eyebrow="Platforms" />
      <LogoWall logos={platformLogos} />
    </div>
  </section>

  <!-- 07 · Contact -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="06" eyebrow="Contact" />
    <CTA />
  </section>
</BaseLayout>

<style>
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  @media (max-width: 480px) {
    .brand-row a {
      width: 100%;
    }
  }
</style>
