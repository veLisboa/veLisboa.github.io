---
/**
 * /work — one page, five sections, deliberately weighted.
 *
 * Architecture used to be the whole site. Here it is one small section of five, because seven
 * diagrams are a part of the practice rather than the practice itself. The AI lab is the longest
 * section, and even that is mostly its own images.
 *
 * No client is named anywhere on this page.
 */
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Figure from "../../components/Figure.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import { byOrder } from "../../content.config";
import {
  credentials,
  delivery,
  industries,
  social,
  klarunLogo,
  architectureOverview,
} from "../../config";

const architectures = (await getCollection("architecture")).sort(byOrder);

/**
 * The overview diagram is being redrawn. Until the file lands in public/, this renders nothing at
 * all — no placeholder, no broken image, no note about what is missing.
 */
const overviewExists = fs.existsSync(
  path.join(process.cwd(), "public", architectureOverview.src.replace(/^\//, "")),
);

const klarunCovers = [
  { icon: "shield", label: "Governance" },
  { icon: "layers", label: "Architecture" },
  { icon: "board", label: "Projects" },
  { icon: "coins", label: "FinOps" },
  { icon: "plus", label: "And more" },
];
---

<BaseLayout
  title="Work"
  section="Work"
  description="Delivery record across 20+ industries, seven reference architectures, Klarun, and agentic tooling for Power BI delivery.">
  <section class="container" style="margin-top:var(--space-9)">
    <span class="kicker"></span>
    <h1 style="max-width:16em">Work</h1>
  </section>

  <!-- 01 · Background and credentials -->
  <section class="container" style="margin-top:var(--space-9)">
    <SectionHeader num="01" eyebrow="Background" />
    <div class="prose">
      <p>
        I came into Data and AI through operations leadership, which is why I care whether a
        control can actually be operated rather than only whether it is correct. Today I lead
        delivery and operations at a Data and AI consultancy, and the teams behind it. I am also
        Data Tech Lead on a client engagement, leading a large SAP S/4HANA migration team for the
        Americas division of a Japanese industrial manufacturer.
      </p>
    </div>

    <div class="specs" style="margin-top:var(--space-8)">
      {
        credentials.map((group) => (
          <div class="spec-row">
            <div class="spec-row__meta">{group.vendor}</div>
            <div class="spec-row__body">
              <ul class="creds" role="list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 02 · Delivery record -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader
        num="02"
        eyebrow="Delivery record"
        title="Where the work has been"
        lede={`${delivery.projects} projects in the last year, across ${delivery.clients} client accounts and more than 20 industries.`}
      />
      <ul class="industries" role="list">
        {industries.map((i) => <li>{i}</li>)}
      </ul>
      <p style="margin-top:var(--space-7);color:var(--ink-secondary);max-width:var(--measure)">
        No client is named on this site. The delivery work is under client confidentiality.
      </p>
    </div>
  </section>

  <!-- 03 · Klarun -->
  <section class="band band--invert" style="margin-top:var(--space-10)">
    <div class="container">
      <div class="klarun">
        <div>
          <SectionHeader num="03" eyebrow="Founder · B2B SaaS" />
          <h2 class="klarun__title">
            Run the estate <span class="tail">from one place.</span>
          </h2>
          <p style="margin-top:var(--space-6);max-width:var(--measure)">
            I am the founder of Klarun, a data ecosystem operations tool. It covers governance,
            architecture, projects, FinOps and more, so a team can run its estate from one place
            instead of six.
          </p>

          <div class="feature-rows" style="margin-top:var(--space-8)">
            {
              klarunCovers.map((c) => (
                <div class="feature-row">
                  <span class="icon-tile">
                    <Icon name={c.icon} size={18} />
                  </span>
                  <span>{c.label}</span>
                </div>
              ))
            }
          </div>

          <a class="btn btn--primary" style="margin-top:var(--space-8)" href={social.klarun}>
            Visit klarun.app
            <Icon name="arrow-up-right" size={18} />
          </a>
        </div>

        {/* The cream export, not the dark one: its own ground is warmer than this band's
            graphite and read as a mismatched rectangle. Here that ground is the plate. */}
        <div class="shot klarun__shot">
          <img src={klarunLogo.onLight} alt="Klarun" width="2400" height="800" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Data architecture -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader
      num="04"
      eyebrow="Data architecture"
      title="Seven reference architectures"
      lede="Published because I keep being asked the same platform questions. Each covers the decision points, the failure modes, and the conditions under which I would not use the pattern. Three are foundations. Four are hybrids that hold the lake in one platform and serve from another."
    />

    {
      overviewExists && (
        <div style="margin-top:var(--space-8)">
          <Figure
            src={architectureOverview.src}
            alt="Overview of the seven reference architectures"
            width={architectureOverview.width}
            height={architectureOverview.height}
            caption="The seven patterns and how they relate."
            meta="Overview"
          />
        </div>
      )
    }

    <div class="specs" style="margin-top:var(--space-8)">
      {
        architectures.map((a) => (
          <div class="spec-row">
            <div class="spec-row__meta">
              <span class="num">{a.data.num}</span>
              {a.data.group === "foundations" ? "Foundation" : "Hybrid"}
            </div>
            <div class="spec-row__body">
              <h3 style="font-size:var(--step-1)">
                <a href={`/work/architecture/${a.id}/`}>{a.data.title}</a>
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 05 · AI lab -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader
        num="05"
        eyebrow="AI lab"
        title="Agents inside a PBIP workflow, with a gate"
        lede="A .pbix is a binary and cannot be diffed. A PBIP project is text, TMDL plus PBIR, so it can be read, reviewed and generated. I built an agentic workflow around that, with an approval gate on every change."
      />
      <div class="workflow-shot">
        <Figure
          src="/powerbi-dev/powerbi-ai-driven-dev.jpeg"
          alt="Eight-step agentic PBIP development workflow: understand, improve behind an approval gate, then build and prove"
          width={1280}
          height={1080}
          caption="Read-only review produces evidence-backed plans; nothing is applied until it is approved, per finding."
          meta="Delivery workflow"
          loading="eager"
        />
      </div>

      <p style="margin-top:var(--space-8);max-width:var(--measure)">
        Report JSON and TMDL emitted by committed Python. One module holds every visual structure
        and another holds the Style objects, so re-skinning a report touches no visual code.
      </p>

      <div class="bento" style="margin-top:var(--space-7)">
        <Figure
          src="/powerbi-dev/dashboard-1.jpeg"
          alt="Performance Overview report — revenue, gross margin and category scorecard"
          width={1527}
          height={855}
          caption="Executive reporting, flat design. Descriptive mode."
          meta="Synthetic data"
        />
        <Figure
          src="/powerbi-dev/dashboard-2.jpeg"
          alt="What Lateness Costs report — review score against delivery lag"
          width={1277}
          height={716}
          caption="Delivery diagnostics, neumorphic design. Review score falls monotonically as an order runs later."
          meta="Olist public dataset · CC BY-NC-SA"
        />
      </div>
    </div>
  </section>

  <!-- 06 · Contact is rendered by BaseLayout, on the one accent ground. -->
</BaseLayout>

<style>
  .creds {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    color: var(--ink-secondary);
    font-size: var(--step--1);
  }

  .industries {
    list-style: none;
    padding: var(--space-6) 0 0;
    margin: var(--space-7) 0 0;
    border-top: var(--hairline);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4) var(--space-7);
    font-size: var(--step--1);
    color: var(--ink-secondary);
  }

  .klarun {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--space-9);
    align-items: center;
  }
  .klarun__title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin: 0;
  }
  .klarun__shot {
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }
  /* The export already carries its own ground, so it needs no border against the band. */
  .klarun__shot :global(img) {
    border: 0;
  }

  /* The workflow diagram is 1280×1080 and was dominating the section at full width. */
  .workflow-shot {
    max-width: 680px;
  }

  @media (max-width: 900px) {
    .industries {
      grid-template-columns: repeat(2, 1fr);
    }
    .klarun {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .klarun__shot {
      justify-self: start;
      max-width: 340px;
    }
  }
  @media (max-width: 520px) {
    .industries {
      grid-template-columns: 1fr;
    }
  }
</style>
