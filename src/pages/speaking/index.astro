---
/**
 * /speaking — the MVP-facing page (§6.6). Track record, talk catalog, proof and booking.
 *
 * Accent budget: the inverted stat band. Nothing else on the page uses tone="accent".
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import StatStrip from "../../components/StatStrip.astro";
import Todo from "../../components/Todo.astro";
import { getCollection } from "astro:content";
import { byOrder } from "../../content.config";
import { contact, affiliations, portrait, writingThemes } from "../../config";

const talks = (await getCollection("talks")).sort(byOrder);
const anyDraftTalks = talks.some((t) => t.data.status !== "real");

const stats = [
  { value: "~5,000", label: "Students trained worldwide" },
  { value: "2022", label: "Microsoft Certified Trainer since" },
  { value: "3", label: "Languages: English, Portuguese, Spanish" },
  { value: "6", label: "Talks ready to deliver" },
];
---

<BaseLayout
  title="Speaking"
  section="Speaking"
  description="Talk catalog, training record, and how to book Vinicius Lisboa for a session, workshop or webinar.">
  <!-- Hero -->
  <section class="container">
    <div class="hero">
      <div>
        <span class="eyebrow" style="display:block;margin-bottom:var(--space-5)">
          Speaking and training
        </span>
        <h1 class="hero__statement" style="font-size:var(--step-4)">
          I speak about what actually holds up in production.
        </h1>
        <p class="hero__sub">
          Fabric and Databricks architecture, governance that people can operate, and the delivery
          tooling around both.
        </p>
      </div>
      <img
        class="hero__portrait"
        src={portrait}
        alt="Vinicius Lisboa"
        width="1242"
        height="1242"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- 01 · Track record -->
  <section class="band band--invert">
    <div class="container">
      <SectionHeader num="01" eyebrow="Track record" />
      <StatStrip stats={stats} />
    </div>
  </section>

  <!-- 02 · Teaching -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="02" eyebrow="Teaching" title="Where I teach" />
    <div class="affil">
      {affiliations.slice(0, 2).map((a) => <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />)}
    </div>
    <p style="margin-top:var(--space-7);color:var(--ink-secondary);max-width:var(--measure)">
      Mentor on Generative AI and Azure programmes for Great Learning, and for UT Austin McCombs
      School of Business on its PGP in AI Agents &amp; Generative AI for Business Applications.
      Webinars and corporate training delivered in English, Portuguese and Spanish.
    </p>
  </section>

  <!-- 03 · Subjects -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader
        num="03"
        eyebrow="Subjects"
        title="What I talk about"
        lede="The same six threads that run through the newsletter. Any of them can be cut to a session, a workshop or a webinar."
      />
      <div class="specs">
        {
          writingThemes.map((t) => (
            <div class="spec-row">
              <div class="spec-row__meta">
                <span class="num">{t.num}</span>
                {t.title}
              </div>
              <div class="spec-row__body">
                <p>{t.line}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 04 · Talk catalog -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader
      num="04"
      eyebrow="Talk catalog"
      title="Ready to deliver"
      lede="Each of these is written. Formats are flexible — say which one suits the slot."
    />
    <div class="specs">
      {
        talks.map((talk, i) => (
          <article class="spec-row">
            <div class="spec-row__meta">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              {[talk.data.level, talk.data.duration].filter(Boolean).join(" · ") || "Any format"}
            </div>
            <div class="spec-row__body">
              <h3 style="font-size:var(--step-2)">{talk.data.title}</h3>
              <p style="color:var(--ink-secondary);margin-top:var(--space-4);max-width:var(--measure)">
                {talk.data.abstract}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    {
      anyDraftTalks && (
        <Todo
          label="Drafted — needs your review"
          what="These abstracts were drafted from your talk titles and need your review before the page goes public — they speak in your name. Audience level and duration are not set on any of them yet."
          source="Edit src/content/talks/*.md, then set status: real."
        />
      )
    }
  </section>

  <!-- 05 · Proof -->
  <section class="container" style="margin-top:var(--space-10)">
    <SectionHeader num="05" eyebrow="Proof" />
    <Todo
      what="An 8-minute English video on a real technical topic. Organizers want to see whether I can hold a room in English before they commit a slot, and nothing else substitutes for it."
      source="Record with OBS, publish to YouTube, embed here with youtube-nocookie."
    />
  </section>

  <!-- 06 · Booking -->
  <section class="band band--tint" style="margin-top:var(--space-10)">
    <div class="container">
      <SectionHeader num="06" eyebrow="Booking" title="How to book" />
      <div class="specs">
        <div class="spec-row">
          <div class="spec-row__meta"><span class="num">01</span>Formats</div>
          <div class="spec-row__body"><p>Keynote, conference session, workshop, webinar.</p></div>
        </div>
        <div class="spec-row">
          <div class="spec-row__meta"><span class="num">02</span>Languages</div>
          <div class="spec-row__body">
            <p>English, Portuguese, Spanish. The talk is written once and delivered in any of the three.</p>
          </div>
        </div>
        <div class="spec-row">
          <div class="spec-row__meta"><span class="num">03</span>Travel</div>
          <div class="spec-row__body"><p>Brazil and Latin America in person. Anywhere remote.</p></div>
        </div>
        <div class="spec-row">
          <div class="spec-row__meta"><span class="num">04</span>Fees</div>
          <div class="spec-row__body">
            <p>Unpaid community events are welcome — user groups, community days and meetups.</p>
          </div>
        </div>
      </div>

      <p style="margin-top:var(--space-8)">
        Write to <a href={`mailto:${contact.email}`}>{contact.email}</a>, or reach me on
        <a href={contact.linkedin}>LinkedIn</a>. There is a
        <a href="/speaking/one-pager/">one-page summary</a> to forward.
      </p>
    </div>
  </section>
</BaseLayout>
