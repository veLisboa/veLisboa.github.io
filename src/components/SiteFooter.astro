---
/**
 * The footer is now just identity.
 *
 * The link columns are gone: "Pages" duplicated the nav two rules above it, and "Elsewhere"
 * belongs in the contact block on the page, as marks rather than as a second list of words.
 * What is left is the lockup, one line of what the site is, and the mono identity row Klarun
 * brackets every surface with.
 */
import Lockup from "./ds/Lockup.astro";
import { site } from "../config";

const year = 2026;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <Lockup size={20} align="column" role={site.role} />
      <p class="footer-blurb">
        Architecture, governance and delivery for data platforms, and the training that keeps them
        running.
      </p>
    </div>

    <div class="footer-row">
      <span>Vinicius Lisboa</span>
      <span>{year}</span>
    </div>
  </div>
</footer>

<style>
  .footer-brand {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: var(--space-9);
    align-items: end;
  }
  @media (max-width: 720px) {
    .footer-brand {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
