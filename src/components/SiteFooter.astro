---
/**
 * Multi-column footer with a mono identity row beneath it.
 *
 * Klarun brackets every surface: chrome at the top, a mono row at the bottom carrying identity
 * on the left and metadata on the right. The columns replace round 1's single link row.
 */
import Lockup from "./ds/Lockup.astro";
import { contact, site, nav, writingThemes } from "../config";

const year = 2026;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div class="footer-col footer-col--brand">
        <Lockup size={20} align="column" role={site.role} />
        <p class="footer-blurb">
          Data architecture and governance for Microsoft Fabric and Databricks estates, and the
          training to keep them running.
        </p>
      </div>

      <div class="footer-col">
        <span class="eyebrow">Pages</span>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/speaking/one-pager/">Speaker one-pager</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="eyebrow">Writing</span>
        <ul>
          {
            writingThemes.slice(0, 5).map((t) => (
              <li>
                <a href="/writing/">{t.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <span class="eyebrow">Elsewhere</span>
        <ul>
          <li><a href={contact.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={contact.github} rel="me">GitHub</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-row">
      <span>Vinicius Lisboa · {site.location}</span>
      <span>{year}</span>
    </div>
  </div>
</footer>
