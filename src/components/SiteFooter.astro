---
/**
 * Multi-column footer with a mono identity row beneath it.
 *
 * Klarun brackets every surface: chrome at the top, a mono row at the bottom carrying identity
 * on the left and metadata on the right.
 *
 * The contact column is the same <CTA> the home page renders, in its compact form, so the two
 * cannot drift apart.
 */
import Lockup from "./ds/Lockup.astro";
import CTA from "./CTA.astro";
import { site, nav } from "../config";

const year = 2026;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div class="footer-col footer-col--brand">
        <Lockup size={20} align="column" role={site.role} />
        <p class="footer-blurb">
          Data architecture and governance for Microsoft Fabric and Databricks estates, and the
          training to keep them running.
        </p>
      </div>

      <div class="footer-col">
        <span class="eyebrow">Pages</span>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/speaking/one-pager/">Speaker one-pager</a></li>
        </ul>
      </div>

      <div class="footer-col footer-col--contact">
        <span class="eyebrow">Elsewhere</span>
        <CTA compact />
      </div>
    </div>

    <div class="footer-row">
      <span>Vinicius Lisboa</span>
      <span>{year}</span>
    </div>
  </div>
</footer>
