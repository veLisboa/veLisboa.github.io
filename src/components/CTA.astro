---
/**
 * The one contact block, on the accent band at the foot of every page that carries it.
 *
 * The three things someone actually does — write, book, connect — are link cards. Everything else
 * is an icon row, which is where the footer's old "Elsewhere" text list went: the same
 * destinations, as marks rather than as a second column of words.
 *
 * Every destination comes from `social`, `booking` and `contact` in src/config.ts.
 */
import Icon from "./Icon.astro";
import { social, contact, booking } from "../config";

const primary = [
  { href: `mailto:${contact.email}`, icon: "mail", label: "Email me", external: false },
  { href: booking, icon: "calendar", label: "Book a meeting", external: false },
  { href: social.linkedin, icon: "linkedin", label: "LinkedIn", external: true },
];

const elsewhere = [
  { href: social.instagram, icon: "instagram", label: "Instagram" },
  { href: social.newsletter, icon: "pen", label: "Newsletter" },
  { href: social.medium, icon: "medium", label: "Medium" },
  { href: social.klarun, icon: "cube", label: "Klarun" },
  { href: social.github, icon: "github", label: "GitHub" },
];
---

<div class="cta">
  <div>
    <span class="kicker"></span>
    <h2 class="cta__title">Let's talk about your data platform.</h2>
    <p class="cta__lede">Available for consulting engagements, talks and workshops.</p>

    <ul class="icon-links" aria-label="Elsewhere">
      {
        elsewhere.map((l) => (
          <li>
            <a href={l.href}>
              <Icon name={l.icon} />
              <span class="vh">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="link-cards">
    {
      primary.map((l) => (
        <li>
          <a class="link-card" href={l.href}>
            <Icon name={l.icon} />
            <span class="link-card__label">{l.label}</span>
            <Icon name={l.external ? "arrow-up-right" : "arrow-right"} size={18} />
          </a>
        </li>
      ))
    }
    <li class="cta__email">{contact.email}</li>
  </ul>
</div>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: var(--space-9);
    align-items: start;
  }
  .cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin: 0;
    max-width: 14em;
  }
  .cta__lede {
    margin-top: var(--space-6);
    max-width: var(--measure);
  }
  .icon-links {
    margin-top: var(--space-8);
  }
  .cta__email {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    margin-top: var(--space-3);
    opacity: 0.78;
  }

  /* Visually hidden, still read aloud. The icon row must not depend on mark recognition. */
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .cta {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
