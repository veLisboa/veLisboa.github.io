---
/**
 * A link to one of the two places the writing actually lives, carrying that platform's own mark
 * and the language it is published in.
 *
 * The marks are LinkedIn's and Medium's own glyphs, inlined and unstyled, the same escape hatch
 * DESIGN-DECISIONS.md §1 already uses for the vendor logo wall. The flags are inline SVG rather
 * than emoji, because "no emoji, in any surface, ever" is on the floor that still holds.
 *
 * Used twice per page at most, side by side. Never repeated down a page.
 */
export interface Props {
  /** BCP-47 tag for the `language` label, which is written in that language. */
  langTag?: string;
  brand: "linkedin" | "medium";
  flag: "br" | "us";
  href: string;
  label: string;
  language: string;
}

const { brand, flag, href, label, language, langTag } = Astro.props;
---

<a class="brand-btn" href={href}>
  <span class="brand-btn__mark" aria-hidden="true">
    {
      brand === "linkedin" ? (
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
        </svg>
      )
    }
  </span>

  <span class="brand-btn__text">
    <span class="brand-btn__label">{label}</span>
    <span class="brand-btn__lang">
      <span class="brand-btn__flag" aria-hidden="true">
        {
          flag === "br" ? (
            <svg viewBox="0 0 16 11" width="16" height="11">
              <rect width="16" height="11" fill="#009b3a" />
              <path d="M8 1.2 14.6 5.5 8 9.8 1.4 5.5Z" fill="#fedf00" />
              <circle cx="8" cy="5.5" r="2.4" fill="#002776" />
            </svg>
          ) : (
            <svg viewBox="0 0 16 11" width="16" height="11">
              <rect width="16" height="11" fill="#fff" />
              <g fill="#b22234">
                <rect width="16" height="1.7" />
                <rect y="3.4" width="16" height="1.7" />
                <rect y="6.8" width="16" height="1.7" />
                <rect y="10.2" width="16" height="0.8" />
              </g>
              <rect width="7" height="5.9" fill="#3c3b6e" />
            </svg>
          )
        }
      </span>
      <span lang={langTag}>{language}</span>
    </span>
  </span>
</a>

<style>
  .brand-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .brand-btn:hover {
    background: var(--paper-sunken);
    border-color: var(--ink);
  }
  .brand-btn__mark {
    display: block;
    flex: none;
    line-height: 0;
  }
  .brand-btn__text {
    display: grid;
    gap: var(--space-2);
  }
  .brand-btn__label {
    font-weight: var(--wt-medium);
    line-height: 1.2;
  }
  .brand-btn__lang {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .brand-btn__flag {
    display: block;
    line-height: 0;
    border: var(--rule-hairline) solid var(--rule);
  }
  .brand-btn__flag svg {
    display: block;
  }
</style>
