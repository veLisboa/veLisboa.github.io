---
/**
 * Sidenote / callout: a medium top rule and a label, no box and no tint.
 * Port of components/core/Callout.jsx.
 *
 * This is what "a card" is in this system. There are no cards.
 */
export interface Props {
  label?: string;
  tone?: "default" | "accent";
  style?: Record<string, string | number>;
  [key: string]: unknown;
}

const { label = "Nota", tone = "default", style, ...rest } = Astro.props;
const accent = tone === "accent";
---

<aside
  {...rest}
  style={{
    borderTop: accent
      ? "var(--rule-medium) solid var(--accent)"
      : "var(--rule-medium) solid var(--rule-strong)",
    paddingTop: "var(--space-4)",
    ...style,
  }}>
  <div
    style={{
      fontFamily: "var(--font-body)",
      fontSize: "var(--step--1)",
      fontWeight: 500,
      letterSpacing: "var(--ls-eyebrow)",
      textTransform: "uppercase",
      color: accent ? "var(--accent)" : "var(--ink-secondary)",
      marginBottom: "var(--space-3)",
    }}>{label}</div>
  <div
    style={{
      fontFamily: "var(--font-body)",
      fontSize: "var(--step-0)",
      lineHeight: "var(--lh-body)",
      color: "var(--ink)",
      maxWidth: "var(--measure-narrow)",
    }}><slot /></div>
</aside>
