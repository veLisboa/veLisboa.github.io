---
/**
 * The site's icon set.
 *
 * DESIGN-DECISIONS.md records this as a departure: the system says "there is deliberately no icon
 * set". This is a small, closed, hand-written one — no font, no sprite sheet, no CDN, no library.
 * Every glyph below is either a geometric primitive drawn on a 24-grid at 1.5 stroke, or a
 * platform's own brand mark used unstyled, which the system already permits.
 *
 * Icons carry meaning that is always also in the adjacent text, so they are aria-hidden.
 */
export interface Props {
  name: string;
  size?: number;
  /** Brand marks are solid; UI glyphs are stroked. */
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const BRAND = new Set(["linkedin", "medium", "instagram", "github"]);
const solid = BRAND.has(name);

const paths: Record<string, string> = {
  // ── UI, stroked on a 24 grid ────────────────────────────────────────────
  "arrow-right": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "arrow-up-right": '<path d="M7 17 17 7M8 7h9v9"/>',
  mail: '<rect x="2" y="5" width="20" height="14" rx="1"/><path d="m2 7 10 6.5L22 7"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  briefcase:
    '<rect x="2" y="7" width="20" height="14" rx="1"/><path d="M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M2 13h20"/>',
