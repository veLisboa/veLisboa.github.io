---
/**
 * Split masthead: wordmark and nav left, mono metadata right.
 *
 * The asymmetric left-heavy / right-metadata split is Klarun's chrome device and does most of
 * the "designed" work for no cost. The right slot answers "where am I".
 *
 * The wordmark is a site-header surface per the design system, and at 26px it clears the 96px
 * width floor, so the monogram does not appear here. The two marks never share a block.
 */
import Wordmark from "./ds/Wordmark.astro";
import { nav } from "../config";

export interface Props {
  section?: string;
}
const { section } = Astro.props;

// trailingSlash is "always", so "/writing/" matches itself and its children.
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__left">
      <a href="/" class="site-header__mark" aria-label="Vinicius Lisboa, home">
        <Wordmark size={26} />
      </a>
      <nav class="site-nav" aria-label="Primary">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="site-header__meta">
      {section && <span class="site-header__section">{section}</span>}
    </div>
  </div>
</header>
