---
/**
 * Shared detail-page layout for anything with a body and a metadata rail.
 *
 * Reproduces the design system's own article structure from ui_kits/newsletter/ArticlePage.jsx:
 * ArticleHeader, then a text column and a metadata rail at minmax(0,1fr) / 260px with a 64px gap.
 * Text sits on 6–8 columns, metadata on 2–3, as guidelines/grid.card.html specifies.
 *
 * <main> is full width now so bands can bleed, so this layout brings its own .container.
 */
import BaseLayout from "./BaseLayout.astro";
import ArticleHeader from "../components/ds/ArticleHeader.astro";
import Rule from "../components/ds/Rule.astro";
import Byline from "../components/ds/Byline.astro";

export interface Props {
  title: string;
  eyebrow?: string;
  standfirst?: string;
  meta?: string[];
  section?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  eyebrow,
  standfirst,
  meta = [],
  section,
  backHref,
  backLabel = "Back",
} = Astro.props;
---

<BaseLayout title={title} description={standfirst} section={section}>
  <article class="container" style="margin-top:var(--space-9)">
    <ArticleHeader eyebrow={eyebrow} title={title} standfirst={standfirst} meta={meta} />

    <div class="body-grid">
      <div class="prose">
        <slot />
      </div>

      <aside class="rail">
        <div>
          <Rule weight="medium" tone="strong" />
          <div class="eyebrow" style="display:block;margin:var(--space-4) 0 var(--space-5)">
            Written by
          </div>
          <Byline />
        </div>
        {
          backHref && (
            <div>
              <Rule />
              <p style="margin-top:var(--space-4);font-size:var(--step--1)">
                <a href={backHref}>{backLabel}</a>
              </p>
            </div>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>
